# ============================================================
# MCA-CMS environment variables
# Copy this file to .env and fill in your values.
#   Copy-Item .env.example .env
# Do NOT commit .env (it is gitignored).
# ============================================================

# Bearer API key for the manage / upload admin endpoints
# (server/middleware/auth.ts). Generate a random one, e.g.:
#   openssl rand -hex 24
NUXT_ADMIN_API_KEY=change-me-to-a-long-random-string

# If you use the bundled cms/ content generator's remote sync, configure it
# in cms/.env (copy cms/.env.example -> cms/.env):
#   BASE_URL=<this site's public URL, e.g. https://www.yourdomain.com>
#   REMOTE_API_KEY=<the same value as NUXT_ADMIN_API_KEY above>
# The generator pushes content via POST /api/{type} with this Bearer key.

# Public site URL (used for sitemap, hreflang, canonical, share links).
# If unset, utils/config.ts -> companyInfo.siteUrl is used.
NUXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Content + assets data directory.
# Local dev: leave unset -> defaults to ./data
NUXT_DATA_DIR=your-local-path
# Production: point at your deployed data folder, e.g.
# NUXT_DATA_DIR=/www/wwwroot/example/data

# SQLite database used by the contact form (Prisma).
# Run once before first use:  npx prisma db push
# Development (relative to prisma/ folder):
DATABASE_URL="file:./dev.db"

# Production (absolute path on the server), e.g. deployed under /www/wwwroot/example:
# DATABASE_URL="file:/www/wwwroot/example/prod.db"
# Make sure the target directory exists and is writable before running prisma db push.

# Password for the /admin login (server/api/auth/login.post.ts).
# Default fallback in code is 'admin123' — change it!
ADMIN_PASSWORD=change-me

# Google Analytics 4 Measurement ID (optional, empty = GA disabled)
NUXT_PUBLIC_GA_ID=
