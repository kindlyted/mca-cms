# ============================================================
# MCA-CMS generator — LLM provider & optional integrations
# Copy this file to .env and fill in your values.
#   Copy-Item .env.example .env
# Do NOT commit .env (it is gitignored).
# ============================================================

# Languages the generator outputs content for (comma-separated).
# Overrides cms/config/settings.py LANGUAGES.
LANGUAGES=en,fr,de

# --- LLM provider (OpenAI-compatible). Configure at least one. ---
# Default LLM provider used by `main.py` (deepseek/zhipu/kimi/qwen/dmx)
# DEFAULT_PROVIDER=deepseek
# DeepSeek
API_KEY_DS=
URL_DS=https://api.deepseek.com/v1
# 智谱 Zhipu
API_KEY_ZHIPU=
URL_ZHIPU=https://open.bigmodel.cn/api/paas/v4
# Kimi (Moonshot)
API_KEY_KIMI=
URL_KIMI=https://api.moonshot.cn/v1
# 通义 Qwen
API_KEY_QWEN=
URL_QWEN=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉
API_KEY_DASHSCOPE=
URL_DASHSCOPE=https://dashscope.aliyuncs.com/api/v1
API_KEY_ARK=
URL_ARK=https://ark.cn-beijing.volces.com/api/v3

# --- Optional: Tavily web search (authoritative sources for blog generation) ---
# Requires: pip install tavily-python
API_KEY_TAVILY=

# --- Optional: Unsplash image download ---
UNP_AKEY=

# --- Optional: AI image generation (Qwen / Seedream) ---
# IMAGE_GENERATOR: how cover/inline images are produced.
#   unsplash = search Unsplash for a free image (default; requires UNP_AKEY above)
#   ai       = generate with an AI model (uses the API keys in the "视觉" section above)
IMAGE_GENERATOR=unsplash

# AI_IMAGE_PROVIDER: which backend to call when IMAGE_GENERATOR=ai.
#   qwen     = 通义千问 DashScope（需上方 API_KEY_DASHSCOPE）
#   seedream = 豆包 Seedream 火山方舟（需上方 API_KEY_ARK）
AI_IMAGE_PROVIDER=qwen

# AI_IMAGE_MODEL: model name for the chosen provider.
#   qwen:     qwen-image-2.0-pro（默认）
#   seedream: doubao-seedream-5-0-260128
AI_IMAGE_MODEL=qwen-image-2.0-pro

# AI_IMAGE_STYLE: visual style applied to generated images.
#   photorealistic = 真实摄影风（默认），适合通用配图
#   cartoon        = 卡通科普风，适合科普插图
#   ink-wash       = 中国国画水墨风，适合中医/文化内容
#   minimalist     = 极简现代风，适合医疗科技
#   nature-healing = 自然疗愈风，适合养生/水疗
AI_IMAGE_STYLE=photorealistic

# --- Site ---
# Used for canonical/hreflang. Overrides config/settings.py BASE_URL.
BASE_URL=https://www.yourdomain.com


# --- Optional: data dir override ---
CMS_DATA_DIR=

# --- Optional: remote sync ---
# Pushes to BASE_URL (same site), so no separate API URL is needed.
REMOTE_API_KEY=
